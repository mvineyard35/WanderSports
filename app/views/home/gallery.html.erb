

<!DOCTYPE html>
<html>
<head>
  <title>Image Gallery</title>
  <style>

  	#background-image {
    position: fixed;
    top: 0;
    left: 50% ;
    transform: translateX(-50% );
    width: 100vw;
    height: 100%;/* Ensure the min-height is 115% to cut off the bottom 15% */
    object-fit: fit; /* Ensure the video covers the entire element */
    object-position: top; /* Align the video to the top */
    z-index: -1000;
  }
  
	#image-overlay {
	  position: fixed;
	  top: 0;
	  left: 0;
	  width: 100% ;
	  min-height: 200% ;
	  background-color: rgba(226, 242, 255, 0.1); /* Overlay color */
	  z-index: -999;
	}
    /* Container styling */
.container {
  display: flex;
  flex-wrap: wrap; /* Allows items to wrap onto multiple lines */
  justify-content: center; /* Centers items horizontally */
  width: 90%;
  margin: 0 auto; /* Centers the container */
  text-align: center; /* Optional: centers the content inside the container */
  min-height: 60vh;
}

/* Post styling */
.post {
  flex: 1 1 calc(25% - 4%); /* Allows items to grow and shrink, with a base width of 25% minus margin space */
  padding: 2%;
  box-sizing: border-box; /* Includes padding and border in the element's total width and height */
  margin: 2%; /* Margin to ensure spacing between items */
}

/* Image styling */
.post img {
  width: 100%; /* Ensures the image takes the full width of the post */
  height: 200px; /* Fixed height for all images */
  object-fit: cover; /* Ensures the image covers the area without distortion */
}

/* Responsive behavior */
@media (max-width: 1200px) {
  .post {
    flex: 1 1 calc(33.33% - 4%); /* Adjust base width to 33.33% minus margin space */
  }
}

@media (max-width: 768px) {
  .post {
    flex: 1 1 calc(50% - 4%); /* Adjust base width to 50% minus margin space */
  }
}

@media (max-width: 480px) {
  .post {
    flex: 1 1 100%; /* Stack items on top of each other on very small screens */
    margin: 1%; /* Adjust margin for better spacing on small screens */
  }
}

  </style>
</head>
<body>

	<%= image_tag 'book-bg.png', id: 'background-image' %>

  <div class='container'>
    <% @images.each do |image| %>
      <div class='post'>
        <%= raw(image.image) %>
      </div>
    <% end %>
  </div>
</body>
</html>
