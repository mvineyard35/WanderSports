<style>
	#background-photo {
    position: fixed;
    top: 0;
    left: 50% ;
    transform: translateX(-50% );
    width: 100vw;
    height: 100% ; /* Ensure the min-height is 115% to cut off the bottom 15% */
    object-fit: fill; /* Ensure the video covers the entire element */
    object-position: top; /* Align the video to the top */
    z-index: -1000;
  }
  
#photo-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100% ;
  min-height: 100% ;
  background-color: rgba(255, 255, 255, 0.88); /* Overlay color */
  z-index: -999;
}

.landing-content {
	margin-left: 10%;
	margin-top: 10%;
	min-height: 40vh;
	position: relative;
	margin-bottom: 10%;
}

.header1 {
	font-family: 'Outfit';
	color: #4A4A4A;
	font-size: 8vmin;
	padding-bottom: 0;
	margin-bottom: 0;
	line-height: .8;
	font-weight: 900;
}

.content-text {
	font-family: 'Outfit';
	font-size: 4vmin;
	color: #4A4A4A;
	font-weight: 100;
	margin-left: 2%;
	margin-top: 1%;
	padding-top: 0;
}

.h1span {
	font-size: 5vmin;
	margin-top: 0;
	padding-top: 0;
	font-weight: 450;
}

.close {
	margin-top: 0;
	padding-top: 0;
}

.header3 {
	font-family: 'Outfit';
	color: #778AC6;
	font-size: 5vmin;
	margin-bottom: 0;
	padding-bottom: 0;
	padding-top: 1%;
	margin-top: 3%;
}

.reserve-button {
	color: whitesmoke;
	background-color: #E55F25;
	border: none;
	border-radius: 4px;
	font-size: 2vmin;
	font-family: sans-serif;
	font-weight: 100;
	text-decoration: none;
	padding-top: 1vw;
	padding-bottom: 1vw;
	padding-left: 2vw;
	padding-right: 2vw;
	margin-left: 3%;
	margin-top: 2%;
}

.reserve-button:hover {
	background-color: #C1450C;
}

.location-content {
	background-color: #E9F5FF;
	min-height: 40vh;
	width: 100%;
	position: relative;
	display: flex;
	padding-bottom: 5%;
	margin-bottom: 0;
}

.location-left, .location-right {
	flex: 1;
}

.indented {
	margin-top: 10%;
	margin-left: 10%;
}

.map {
  display: flex; /* Use flexbox for alignment */
  align-items: center; /* Center items vertically */
  margin-left: 10%;
  margin-top: 2%;
  text-decoration: none;
  font-family: sans-serif;
  font-weight: 450;
  font-size: 2vmin;
  color: #4A4A4A;
  width: 10em;
}

.map img {
  margin-right: 10px; /* Add some spacing between image and text */
}

.map:hover {
	transform: scale(1.025);
}


.map-image {
	width: 70%;
	height: auto;
	margin-left: 15%;
	padding-top: 10%;
}

.map-text {
	font-size: 2vmin;
	font-family: sans-serif;
	font-weight: 450;
	color: #4A4A4A;
	margin-left: 10%;
	margin-top: 3%;
	margin-bottom: 3%;
}

.special {
  height: auto;  /* Adjust as needed for size */
  width: 60%;
  position: relative;
  margin-right: 0;
  padding-right: 0;
  margin-left: auto;
  display: flex;
  justify-content: center;
  align-items: center;
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
}

.special-text {
  padding: 10%;
  font-family: sans-serif;
  font-weight: 100;
  font-size: 4vmin;
  color: black;
  text-align: center;  /* Center text inside the star */
  width: 60%;
}

.map-icon {
	height: 2vmin;
}

.hours {
  background-color: #E9F5FF;
  margin: 0 auto;
  padding: 10vmin;
  width: 100%;
  background-image: url(<%= asset_path('hours.svg') %>); /* Replace 'your_image.png' with your image file */
  background-size: cover;  /* Ensures the image covers the whole div */
  background-position: bottom center; /* Aligns the image to the bottom and center horizontally */
  background-repeat: no-repeat;
}

.hours h2 {
  margin-top: 0;
  font-weight: 100;
  font-family: sans-serif;
  font-size: 4vmin;
  color: #4A4A4A;
}

.hours-table {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-top: 5vmin;
}

.hours-row {
  display: flex;
  justify-content: space-between;
  width: 100%;
  padding: 2vmin 0;
}

.hours-header {
  font-family: sans-serif;
  font-weight: 100;
  font-size: 2vmin;
  flex: 1;
}

.hours-info {
  flex: 2;
  font-family: sans-serif;
  font-weight: 100;
  font-size: 2vmin;
}



</style>

	<% @specials.each do |special| %>
      <div class="special" style="background-image: url(<%= asset_path('special.png') %>);">
        <p class = 'special-text'><%= special.info %></p>
      </div>
    <% end %>

<%= image_tag 'bg.jpeg', id: 'background-photo' %>
<div id='photo-overlay'></div>

<div class = 'landing-content'>




	<h1 class = 'header1'>Get on the water<br><span class = 'h1span'>&nbsp&nbsp&nbspLet the adventure begin</span></h1>
	<h3 class = 'header3'>Check out our unbeatable deals!</h3>
	<p class = 'content-text' style = 'font-weight: 400;'>Planning for a weekend or a holiday?</p>
	<%= link_to 'Book Now', reservations_reserve_path, class: 'reserve-button'%>
</div>

<div class = 'location-content'>
	<div class = 'location-left'>
		<p class = 'content-text indented' style = 'font-weight: 300;'>We're local in Charlotte and just a short drive from anywhere in the Charlotte Metro Area!</p>
		<p class = 'map-text'>1400 Richmond Pl<br>Charlotte, NC 28209</p>
		<a href="http://maps.apple.com/?address=1400+Richmond+Pl,Charlotte,NC,28209" class = 'map'><%= image_tag 'apple.svg'%> Apple Map</a>
		<a href="https://www.google.com/maps/search/?api=1&query=1400+Richmond+Pl,Charlotte,NC,28209" class = 'map'><%= image_tag 'google.svg'%> Google Map</a>


		
	</div>
	<div class = 'location-right'>
		<%= image_tag 'map.png', class: 'map-image'%>
		
	</div>


	
</div>

<% if @hours.any? %>

<div class="hours">
  <h2>Business Hours</h2>
  <div class="hours-table">
    <div class="hours-row">
      <div class="hours-header">Monday to Friday</div>
      <div class="hours-info"><%= @hours.first.mon_fri %></div>
    </div>
    <div class="hours-row">
      <div class="hours-header">Saturday</div>
      <div class="hours-info"><%= @hours.first.sat %></div>
    </div>
    <div class="hours-row">
      <div class="hours-header">Sunday</div>
      <div class="hours-info"><%= @hours.first.sun %></div>
    </div>
  </div>
</div>

<% end %>