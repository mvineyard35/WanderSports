<%= image_tag 'book-bg.png', id: 'background-image' %>
<div id='image-overlay'></div>


<div class="content">

<p class = 'header'>Rentals</p>
  
   


<p class = 'text2'><%= image_tag 'veteran.svg', class: 'veteran'%><span class = 'main'>Veterans Discount:</span> 10% off with valid proof of service (pay in person)</p>


<div class = 'info-container5'>
<div class = 'info5'>
      <svg width="14" min-height="14" viewBox="0 0 20 20">
          <polygon points="0,20 10,0 20,20" fill="#E55F25" transform='rotate(90 10 10)' stroke="#E55F25" stroke-width="2" stroke-linejoin="round"/> <!-- Adjust points and fill color as needed -->
      </svg>
      <p class = 'text5'>All rentals require a valid ID and signed rental agreement</p>
    </div>

    <div class = 'info52'>
      <svg width="14" min-height="14" viewBox="0 0 20 20">
          <polygon points="0,20 10,0 20,20" fill="#E55F25" transform='rotate(90 10 10)' stroke="#E55F25" stroke-width="2" stroke-linejoin="round"/> <!-- Adjust points and fill color as needed -->
      </svg>
      <p class = 'text5'>Rentals subjet to availability</p>
    </div>

    <div class = 'info52'>
      <svg width="14" min-height="14" viewBox="0 0 20 20">
          <polygon points="0,20 10,0 20,20" fill="#E55F25" transform='rotate(90 10 10)' stroke="#E55F25" stroke-width="2" stroke-linejoin="round"/> <!-- Adjust points and fill color as needed -->
      </svg>
      <p class = 'text5'>Rentals returned late will be charged a late fee as stated in the rental<br> agreement.  An authorization hold of $100/Paddle Board is required<br> prior to pick up.</p>
    </div>
</div>

<p class = 'header2'>Included with each rental:</p>
<p class = 'text'><%= image_tag 'checkmark.svg', class: 'checkmark'%>Inflatable Stand Up Paddle Board</p>
<p class = 'text'><%= image_tag 'checkmark.svg', class: 'checkmark'%>Collapsible and Adjustable Paddle</p>
<p class = 'text'><%= image_tag 'checkmark.svg', class: 'checkmark'%>Life Jacket</p>
  <p class = 'text'><%= image_tag 'checkmark.svg', class: 'checkmark'%>Electric Pump (Plugs into your car's outlet)</p>
  <p class = 'text'><%= image_tag 'checkmark.svg', class: 'checkmark'%>Heavy Duty Backpack</p>
  <p class = 'text'><%= image_tag 'checkmark.svg', class: 'checkmark'%>Waterproof Dry Bag</p>
  <p class = 'text'><%= image_tag 'checkmark.svg', class: 'checkmark'%>Detachable Fin</p>
  <p class = 'text'><%= image_tag 'checkmark.svg', class: 'checkmark'%>Emergency Whistle</p>


<p class="header2">Inflatable Standup Paddle Board</p>


<div class="products" id='products'>
  <% @products.each do |product| %>
  <% if product.metadata['color'].present? %>
    <div class = 'product dark'>
      <% else %>
    <div class="product">
      <% end %>
      <img src="<%= product.images.first %>" alt="Image" class='product-image'>
      <p style = 'font-size: 3vmin; font-weight: 300;'><%= product.name %></p>
      <p style = 'font-size: 2vmin;'><%= product.description %></p>
      <% if product.metadata['price'].present? %>
        <p style = 'font-size: 4vmin;'><%= number_to_currency(product.metadata['price'].to_i / 100.0, unit: '$') %></p>
      <% else %>
        <p>Price not available</p>
      <% end %>
      

      <%= form_with url: add_to_cart_product_path(product.id), method: :post do %>
  <div style="text-align: left; width: 100%; display: flex; align-items: center; margin-bottom: 10px;">
    <%= label_tag :quantity, "Quantity", style: "margin-right: 10px;" %>
    <div class="buttons">
      <button type="button" class="decrease quantity-button">-</button>
      <input type="number" name="quantity" class="quantity" value="1" min="1" style="text-align: center; width: 40px; margin: 0 5px;" />
      <button type="button" class="increase quantity-button">+</button>
    </div>
  </div>




        <%= submit_tag 'Add to Cart', class: 'add-button' %>
      <% end %>
    </div>

  <% end %>
</div>
<script>
          document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.decrease').forEach(button => {
    button.addEventListener('click', function() {
      const quantityInput = this.nextElementSibling;
      let currentValue = parseInt(quantityInput.value) || 0;
      if (currentValue > 1) {
        quantityInput.value = currentValue - 1;
      }
    });
  });

  document.querySelectorAll('.increase').forEach(button => {
    button.addEventListener('click', function() {
      const quantityInput = this.previousElementSibling;
      let currentValue = parseInt(quantityInput.value) || 0;
      quantityInput.value = currentValue + 1;
    });
  });
});



        </script>
</div>

