<h1>Your Cart</h1>

<% if @cart_items.any? %>
  <ul>
    <% @cart_items.each do |cart_item| %>
      <li>
        <%= cart_item.product.name %> - <%= number_to_currency(cart_item.product.metadata['price'].to_i / 100.0, unit: '$') %>
        (Quantity: <%= cart_item.quantity %>)
        <%= button_to 'Remove from Cart', remove_item_cart_path(cart_item.id), method: :delete %>
      </li>
    <% end %>
  </ul>
  <%= button_to 'Checkout', checkout_path, method: :post %>
<% else %>
  <p>Your cart is empty.</p>
<% end %>
